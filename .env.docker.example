# Copy to .env before running `docker compose up`.

# Shared login password. The server refuses to start on a non-loopback address
# without it. Everyone who knows it shares one workspace and sees every meeting.
MEETILY_PASSWORD=change-me-please

# Host port for the web UI.
MEETILY_PORT=8080

# Set to 1 when a TLS-terminating reverse proxy sits in front of the container, so
# the session cookie is marked Secure.
MEETILY_COOKIE_SECURE=0

# Local LLM for summaries. Matches the optional `ollama` compose profile.
# Blank it out to use cloud providers configured in the UI instead.
OLLAMA_ENDPOINT=http://ollama:11434

# GPU acceleration for Whisper. Leave FEATURES empty for a CPU build.
#   NVIDIA: MEETILY_FEATURES=cuda + MEETILY_RUST_BASE=nvidia/cuda:12.4.1-devel-ubuntu22.04
#   AMD/Intel: MEETILY_FEATURES=vulkan
MEETILY_FEATURES=
# Needs rustc 1.88 or newer: the cidre dependency is edition 2024.
MEETILY_RUST_BASE=rust:1.90-bookworm

# info | debug | trace
RUST_LOG=info
